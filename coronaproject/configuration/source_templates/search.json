{
  "class_name": "page",
  "page_name": "page_search",
  "default": true,
  "children": [
    {
      "class_name": "column",
      "box": "full_container",
      "children": [
        {
          "class_name": "row",
          "name": "search_section",
          "box": {
            "width": "1.0 container",
            "height": "1.0 remaining"
          },
          "padding": "8 pixels",
          "children": [
            {
              "class_name": "navigation",
              "name": "search_commands",
              "box": {
                "width": "300 pixels",
                "height": "1.0 container"
              },
              "view_style": {
                "box_fill_brush": {
                  "class_name": "solid_brush",
                  "color": "263342"
                },
                "box_border_brush": {
                  "class_name": "solid_brush",
                  "color": "010162"
                },
                "box_border_thickness": 0
              },
              "padding": "0 pixels",
              "wrap": true,
              "children": [
                {
                  "class_name": "navigation_section",
                  "name": "global_score_card",
                  "box": {
                    "width": "1.0 container",
                    "height": "90 pixels"
                  },
                  "content_alignment": "far",
                  "children": [
                    {
                      "class_name": "command_button",
                      "name": "mission_button",
                      "image": "mission.png",
                      "text": "To Mission",
                      "box": {
                        "width": "100 pixels",
                        "height": "75 pixels"
                      },
                      "on_click": {
                        "class_name": "load_object",
                        "form_name": "search_input",
                        "target_frame": "frame_selected",
                        "object_key": {
                          "class_name": "mission",
                          "object_id": 42
                        },
                        "sources": {
                          "mission": "object_mission"
                        }
                      }
                    },
                    {
                      "class_name": "command_button",
                      "name": "clear_list_button",
                      "image": "clear.png",
                      "text": "Clear List",
                      "box": {
                        "width": "100 pixels",
                        "height": "75 pixels"
                      },
                      "on_click": {
                        "class_name": "list_clear",
                        "table_name": "result_table"
                      }
                    }

                  ]
                },
                {
                  "class_name": "navigation_section_title",
                  "name": "navigation_title",
                  "box": {
                    "width": "1.0 container",
                    "height": "25 pixels"
                  },
                  "text": "Dataset"
                },
                {
                  "class_name": "navigation_section",
                  "name": "search_groups",
                  "box": {
                    "width": "1.0 container",
                    "height": "160 pixels"
                  },
                  "wrap": true,
                  "children": [
                    "$search_groups"
                  ]
                },
                {
                  "class_name": "navigation_section_subtitle",
                  "name": "search_title",
                  "box": {
                    "width": "1.0 container",
                    "height": "25 pixels"
                  },
                  "text": "Search"
                },
                {
                  "class_name": "navigation_section",
                  "name": "search_criteria",
                  "box": {
                    "width": "1.0 container",
                    "height": "75 pixels"
                  },
                  "children": [
                    {
                      "class_name": "edit",
                      "name": "search_input",
                      "json_field_name": "full_text",
                      "placeholder": "Search text",
                      "default_focus": true,
                      "box": {
                        "width": "200 pixels",
                        "height": "40 pixels"
                      },
                      "text_style": {
                        "font_name": "Arial",
                        "font_size": 25
                      }
                    },
                    {
                      "class_name": "command_button",
                      "name": "search_button",
                      "icon": "Search",
                      "text": "Search",
                      "split_button": true,
                      "box": {
                        "width": "100 pixels",
                        "height": "40 pixels"
                      },
                      "on_click": {
                        "class_name": "run_query",
                        "form_name": "search_input",
                        "table_name": "result_table",
                        "detail_frame": "frame_selected",
                        "set": {
                          "search_section.search_commands.section_title.text": "",
                          "search_top_bar.list_title.text": "",
                          "search_top_bar.edit_title.text": "",
                          "this.from_class": "from_class"
                        },
                        "query": {
                          "from": [
                            {
                              "class_name": "sys_object",
                              "name": "objects",
                              "filter": {
                                "full_text": "$this.full_text"
                              }
                            }
                          ],
                          "stages": [
                            {
                              "class_name": "result",
                              "source": "objects",
                              "name": "final"
                            }
                          ]
                        }
                      }
                    }
                  ]
                },
                {
                  "class_name": "navigation_section_subtitle",
                  "name": "create_title",
                  "box": {
                    "width": "1.0 container",
                    "height": "25 pixels"
                  },
                  "text": "Create"
                },
                {
                  "class_name": "navigation_section",
                  "name": "create_commands",
                  "box": {
                    "width": "1.0 container",
                    "height": "75 pixels"
                  },
                  "wrap": true,
                  "children": []
                },
                {
                  "class_name": "navigation_section_subtitle",
                  "name": "reports_title",
                  "box": {
                    "width": "1.0 container",
                    "height": "25 pixels"
                  },
                  "text": "Reports"
                },
                {
                  "class_name": "navigation_section",
                  "name": "report_commands",
                  "box": {
                    "width": "1.0 container",
                    "height": "1.0 remaining"
                  },
                  "wrap": true,
                  "children": []
                }
              ]
            },

            {
              "class_name": "column",
              "name": "search_result",
              "box": {
                "width": "400 pixels",
                "height": "1.0 container"
              },
              "children": [
                {
                  "class_name": "items_view",
                  "name": "result_table",
                  "json_field_name": "search_results",
                  "box": {
                    "width": "1.0 container",
                    "height": "1.0 container"
                  },
                  "padding": "2 pixels",
                  "sources": "card_sources",
                  "empty_text": "No items in list",
                  "empty_command": {
                    "class_name": "select_frame",
                    "target_frame": "page_home.frame_selected",
                    "source_frame": "page_empty",
                    "message": "layout test."
                  },
                  "select_command": {
                    "class_name": "list_select_object",
                    "target_frame": "page_home.frame_selected",
                    "table_name": "result_table",
                    "sources": "form_sources"
                  }
                }
              ]
            },

            {
              "class_name": "column",
              "name": "object_edit_bar",
              "box": {
                "width": "100 pixels",
                "height": "1.0 container"
              },
              "view_style": {
                "box_fill_brush": {
                  "class_name": "solid_brush",
                  "color": "263342"
                },
                "box_border_brush": {
                  "class_name": "solid_brush",
                  "color": "010162"
                },
                "box_border_thickness": 0
              },

              "children": [
                {
                  "class_name": "command_button",
                  "name": "save_object",
                  "image": "save.png",
                  "text": "save",
                  "box": {
                    "width": "100  pixels",
                    "height": "75 pixels"
                  },
                  "on_click": {
                    "class_name": "save_object",
                    "form_name": "frame_selected",
                    "target_frame": "frame_selected"
                  }
                },
                {
                  "class_name": "command_button",
                  "name": "delete_object",
                  "image": "trash.png",
                  "text": "delete",
                  "box": {
                    "width": "100  pixels",
                    "height": "75 pixels"
                  },
                  "on_click": {
                    "class_name": "delete_object",
                    "target_frame": "frame_selected"
                  }
                }
              ]
            },
            {
              "class_name": "column",
              "name": "frame_bar",
              "box": {
                "width": "1.0 remaining",
                "height": "1.0 container"
              },
              "view_style": {
                "box_fill_brush": {
                  "class_name": "solid_brush",
                  "color": "39495B"
                }
              },
              "children": [
                {
                  "class_name": "column",
                  "name": "search_container",
                  "box": {
                    "width": "1.0 container",
                    "height": "1.0 remaining"
                  },
                  "children": [
                    {
                      "class_name": "frame",
                      "name": "frame_selected",
                      "edit_bars": [ "object_edit_bar" ],
                      "box": {
                        "width": "1.0 container",
                        "height": "1.0 remaining"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}