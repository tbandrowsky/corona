{
  "class_name": "page",
  "page_name": "page_search",
  "default": true,
  "children": [
    {
      "class_name": "column",
      "box": "full_container",
      "children": [
        {
          "class_name": "placeholder",
          "name": "search_placeholder",
          "text": "",
          "box": {
            "width": "1.0 container",
            "height": "16.0 pixels"
          }
        },
        {
          "class_name": "row",
          "name": "search_top_bar",
          "box": {
            "width": "1.0 container",
            "height": "40 pixels"
          },
          "padding": "8 pixels",
          "children": [
            {
              "class_name": "chaptertitle",
              "name": "score_title",
              "box": {
                "width": "450 pixels",
                "height": "40 pixels"
              },
              "text": "MISSION"
            },
            {
              "class_name": "chaptertitle",
              "name": "list_title",
              "box": {
                "width": "410 pixels",
                "height": "40 pixels"
              },
              "text": "LIST"
            },
            {
              "class_name": "chaptertitle",
              "name": "edit_title",
              "box": {
                "width": "1.0 remaining",
                "height": "40 pixels"
              },
              "text": "DETAIL"
            }
          ]
        },
        {
          "class_name": "row",
          "name": "search_section",
          "box": {
            "width": "1.0 container",
            "height": "1.0 remaining"
          },
          "padding": "8 pixels",
          "children": [
            {
              "class_name": "column",
              "name": "search_commands",
              "box": {
                "width": "450 pixels",
                "height": "1.0 container"
              },
              "view_style": {
                "box_fill_brush": {
                  "class_name": "solid_brush",
                  "color": "111121"
                },
                "box_border_brush": {
                  "class_name": "solid_brush",
                  "color": "010102"
                },
                "box_border_thickness": 0
              },
              "padding": "0 pixels",
              "wrap": true,
              "children": [
                {
                  "class_name": "column",
                  "name": "global_score_card",
                  "box": {
                    "width": "1.0 container",
                    "height": "90 pixels"
                  },
                  "wrap": true,
                  "children": [
                    {
                      "class_name": "code",
                      "name": "invasion_score_card_title",
                      "prompt": "INVADER SCORE {invasion_score}",
                      "box": {
                        "width": "1.0 container",
                        "height": "40 pixels"
                      }
                    },
                    {
                      "class_name": "code",
                      "name": "training_score_card_title",
                      "prompt": "YOUR SCORE {training_score}",
                      "box": {
                        "width": "1.0 container",
                        "height": "40 pixels"
                      }
                    }
                  ]
                },
                {
                  "class_name": "chaptertitle",
                  "name": "navigation_title",
                  "box": {
                    "width": "450 pixels",
                    "height": "40 pixels"
                  },
                  "text": "RECORDS"
                },
                {
                  "class_name": "row",
                  "name": "search_groups",
                  "box": {
                    "width": "1.0 container",
                    "height": "80 pixels"
                  },
                  "wrap": true,
                  "children": [
                    "$search_groups"
                  ]
                },
                {
                  "class_name": "chaptertitle",
                  "name": "section_title",
                  "box": {
                    "width": "450 pixels",
                    "height": "40 pixels"
                  },
                  "text": "SELECTED"
                },
                {
                  "class_name": "row",
                  "name": "search_criteria",
                  "box": {
                    "width": "1.0 container",
                    "height": "50 pixels"
                  },
                  "view_style": {
                    "box_fill_brush": {
                      "class_name": "solid_brush",
                      "color": "111121"
                    },
                    "box_border_brush": {
                      "class_name": "solid_brush",
                      "color": "111112"
                    },
                    "box_border_thickness": 4
                  },
                  "children": [
                    {
                      "class_name": "edit",
                      "name": "search_input",
                      "json_field_name": "full_text",
                      "placholder": "Search text",
                      "default_focus": true,
                      "box": {
                        "width": "300 pixels",
                        "height": "50 pixels"
                      },
                      "text_style": {
                        "font_name": "Arial",
                        "font_size": 24
                      }
                    },
                    {
                      "class_name": "command_button",
                      "name": "search_button",
                      "icon": "Search",
                      "text": "Search",
                      "box": {
                        "width": "100 pixels",
                        "height": "50 pixels"
                      },
                      "on_click": {
                        "class_name": "run_query",
                        "form_name": "search_input",
                        "table_name": "result_table",
                        "detail_frame": "frame_selected",
                        "set": {
                          "search_section.search_commands.section_title.text": "",
                          "search_top_bar.list_title.text": "",
                          "search_top_bar.edit_title.text": "",
                          "this.from_class": "from_class"
                        },
                        "query": {
                          "from": [
                            {
                              "class_name": "sys_object",
                              "name": "objects",
                              "filter": {
                                "full_text": "$this.full_text"
                              }
                            }
                          ],
                          "stages": [
                            {
                              "class_name": "result",
                              "source": "objects",
                              "name": "final"
                            }
                          ]
                        }
                      }
                    }
                  ]
                },
                {
                  "class_name": "row",
                  "name": "new_object_commands",
                  "box": {
                    "width": "1.0 remaining",
                    "height": "1.0 remaining"
                  },
                  "wrap": true,
                  "children": []
                }
              ]
            },

            {
              "class_name": "column",
              "name": "search_result",
              "box": {
                "width": "400 pixels",
                "height": "1.0 container"
              },
              "children": [
                {
                  "class_name": "items_view",
                  "name": "result_table",
                  "json_field_name": "search_results",
                  "box": {
                    "width": "1.0 container",
                    "height": "1.0 container"
                  },
                  "padding": "2 pixels",
                  "sources": "card_sources",
                  "empty_text": "No items in list",
                  "empty_command": {
                    "class_name": "select_frame",
                    "target_frame": "page_home.frame_selected",
                    "source_frame": "page_empty",
                    "message": "layout test."
                  },
                  "select_command": {
                    "class_name": "list_select_object",
                    "target_frame": "page_home.frame_selected",
                    "table_name": "result_table",
                    "sources": "form_sources"
                  }
                }
              ]
            },

            {
              "class_name": "paragraph",
              "name": "frame_spacer",
              "box": {
                "width": "10 pixels",
                "height": "1.0 container"
              }
            },

            {
              "class_name": "column",
              "name": "object_edit_bar",
              "box": {
                "width": "100 pixels",
                "height": "1.0 container"
              },
              "view_style": {
                "box_fill_brush": {
                  "class_name": "solid_brush",
                  "color": "111121"
                },
                "box_border_brush": {
                  "class_name": "solid_brush",
                  "color": "111112"
                },
                "box_border_thickness": 4
              },

              "children": [
                {
                  "class_name": "command_button",
                  "name": "save_object",
                  "image": "save.png",
                  "text": "save",
                  "box": {
                    "width": "100  pixels",
                    "height": "75 pixels"
                  },
                  "on_click": {
                    "class_name": "save_object",
                    "form_name": "frame_selected",
                    "target_frame": "frame_selected"
                  }
                },
                {
                  "class_name": "command_button",
                  "name": "delete_object",
                  "image": "trash.png",
                  "text": "delete",
                  "box": {
                    "width": "100  pixels",
                    "height": "75 pixels"
                  },
                  "on_click": {
                    "class_name": "delete_object",
                    "target_frame": "frame_selected"
                  }
                }
              ]
            },
            {
              "class_name": "paragraph",
              "name": "frame_spacer",
              "box": {
                "width": "10 pixels",
                "height": "1.0 container"
              }
            },
            {
              "class_name": "column",
              "name": "frame_bar",
              "box": {
                "width": "1.0 remaining",
                "height": "1.0 container"
              },
              "children": [
                {
                  "class_name": "column",
                  "name": "search_container",
                  "box": {
                    "width": "1.0 container",
                    "height": "1.0 remaining"
                  },
                  "children": [
                    {
                      "class_name": "frame",
                      "name": "frame_selected",
                      "edit_bars": [ "object_edit_bar" ],
                      "box": {
                        "width": "1.0 container",
                        "height": "1.0 remaining"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}