{
  "class_name": "page",
  "page_name": "card_container",
  "children": [
    {
      "class_name": "row",
      "name": "current_object",
      "box": {
        "width": "1.0 container",
        "height": "$card_height"
      },
      "view_style": {
        "text_style": {
          "font_name": "Century Gothic,Arial",
          "font_size": 14,
          "bold": false,
          "underline": false,
          "vertical_alignment": "near"
        },
        "shape_border_thickness": 0,
        "box_border_thickness": 0,
        "shape_fill_brush": {
          "class_name": "solid_brush",
          "color": "FFFFEE"
        },
        "box_fill_brush": {
          "class_name": "solid_brush",
          "color": "000000"
        }
      },
      "padding": "8 pixels",
      "children": [
        {
          "class_name": "column",
          "name": "current_object_header",
          "box": {
            "width": "100.0 pixels",
            "height": "1.0 container"
          },
          "children": [
            {
              "class_name": "paragraph",
              "box": {
                "width": "1.0 container",
                "height": "20 pixels"
              },
              "json_field_name": "class_name",
              "prompt": "{class_name} #{object_id}"
            },
            {
              "class_name": "image",
              "image_filename": "$icon_image_file",
              "box": {
                "width": "50 pixels",
                "height": "50 pixels"
              }
            }
          ]
        },
        {
          "class_name": "column",
          "name": "current_object",
          "box": {
            "width": "1.0 remaining",
            "height": "1.0 container"
          },
          "children": [
            "$card_contents"
          ]
        }
      ]
    }
  ]
}
