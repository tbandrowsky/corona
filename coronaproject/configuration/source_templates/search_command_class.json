{
  "class_name": "command_button",
  "name": "$search_button_name",
  "image": "$search_button_image",
  "text": "$search_button_text",
  "box": {
    "width": "100 pixels",
    "height": "75 pixels"
  },
  "on_click": {
    "class_name": "run_query",
    "form_name": "search_input",
    "table_name": "result_table",
    "detail_frame": "frame_selected",
    "result_text": "$result_text",
    "edit_text": "$edit_text",
    "search_common_text": "$search_common_text",
    "result_text_control": "$result_text_control",
    "edit_text_control": "$edit_text_control",
    "result_commands": [ "$create_commands" ],
    "result_commands_control": "$commands_control",
    "update_filter": "$update_filter",
    "set": {
      "search_criteria.search_button.set": {
        "search_ceremony.search_common_text": "$search_common_text",
        "search_ceremony.search_prompt_text": "$search_prompt_text",
        "search_ceremony.edit_prompt_text": "$edit_prompt_text",
        "this.from_class": "$search_button_class"
      }
    },
    "query": {
      "from": [
        {
          "class_name": "$search_button_class",
          "name": "objects",
          "filter": {
            "full_text": "$this.full_text"
          }
        }
      ],
      "stages": [
        {
          "class_name": "result",
          "source": "objects",
          "name": "final"
        }
      ]
    }
  }
}
