{
	"schema_name": "Revolution Arcade",
	"schema_description": "Revolution Arcade Application Schema",
	"schema_version": "1.1",
	"schema_authors": [
		"TJ Bandrowsky"
	],
	"datasets": [
		{
			"dataset_name": "Revolution Arcade Teams",
			"dataset_description": "Teams and their default memberships",
			"dataset_version": "1.1",
			"dataset_author": "Todd Bandrowsky",
			"dataset_source": "This is canonical, and the use of sys_team means it can go first",
			"objects": [
				{
					"class_name": "sys_team",
					"team_name": "app_team",
					"team_description": "local player team",
					"team_domain": "localhost.com",
					"inventory_classes": [],
					"allowed_teams": [],
					"permissions": [
						{
							"class_name": "sys_grant",
							"grant_classes": [ "sys_object" ],
							"get": "any",
							"put": "any",
							"delete": "any",
							"alter": "any"
						}
					]
				}
			]
		}
	],
	"classes": [
		{
			"class_name": "game_base",
			"base_class_name": "sys_object",
			"class_description": "Base class of game for permissions",
			"fields": {
			}
		},
		{
			"class_name": "piece_type",
			"base_class_name": "game_base",
			"class_description": "a type of gaming piece",
			"full_text": [ "name", "description", "piece_class_name", "inventory" ],
			"fields": {
				"name": "string",
				"description": "string",
				"piece_class_name": "string",
				"animations": [ "animation" ],
				"mass": "double",
				"health": "double",
				"full_health": "double",
				"state": "string",
				"pieces": [ "piece" ],
				"defaults": "object",
				"inventory": {
					"field_type": "chest",
					"item_class": "piece_type"
				}
			},
			"indexes": {
				"piece_type_index": {
					"index_keys": [ "name" ]
				}
			}
		},
		{
			"class_name": "piece",
			"base_class_name": "game_base",
			"class_description": "a gaming piece",
			"parents": [ "piece_type" ],
			"full_text": [ "name" ],
			"fields": {
				"name": "string",
				"mass": "double",
				"health": "double",
				"full_health": "double",
				"state": "string",
				"position": "vector",
				"size": "vector",
				"velocity": "vector",
				"facing": "vector",
				"owner": "->piece",
				"inventory": {
					"field_type": "chest",
					"item_class": "piece"
				},
				"animations": [ "animation" ]
			}
		},
		{
			"class_name": "animation",
			"base_class_name": "game_base",
			"class_description": "a gaming piece",
			"parents": [ "piece", "piece_type" ],
			"full_text": [ "name" ],
			"fields": {
				"name": {
					"field_type": "string",
					"label": "Name"
				},
				"destination": "rectangle",
				"direction": "vector",
				"sound": "audio",
				"frames": [ "frame" ],
				"carry_point": "vector"
			}
		},
		{
			"class_name": "frame",
			"base_class_name": "game_base",
			"class_description": "a gaming piece",
			"parents": [ "animation" ],
			"full_text": [ "name" ],
			"fields": {
				"start_seconds": {
					"field_type": "double",
					"label": "Start Seconds"
				},
				"stop_seconds": {
					"field_type": "double",
					"label": "Stop Seconds"
				},
				"draw_rectangle": "rectangle",
				"fire_point": "vector",
				"sound": "audio"
			}
		},
		{
			"class_name": "bitmap_frame",
			"base_class_name": "frame",
			"class_description": "a gaming piece of an image",
			"fields": {
				"image": "bitmap"
			}
		},
		{
			"class_name": "vector_frame",
			"base_class_name": "frame",
			"class_description": "a gaming piece of an image",
			"fields": {
				"shape": "path",
				"fill": "brush",
				"stroke": "brush",
				"stroke_width": "double"
			}
		},
		{
			"class_name": "piece_list",
			"base_class_name": "game_base",
			"class_description": "a list of gaming pieces",
			"parents": [ "map", "switcher" ],
			"fields": {
				"state": "string",
				"pieces ": [ "piece" ]
			}
		},
		{
			"class_name": "actor",
			"base_class_name": "piece",
			"class_description": "a gaming player",
			"fields": {
				"selection": "selection",
				"stopped_velocity": "double",
				"crawling_velocity": "double",
				"walking_velocity": "double",
				"running_velocity": "double",
				"throwing_velocity": "double"
			}
		},
		{
			"class_name": "player",
			"base_class_name": "actor",
			"class_description": "a gaming player",
			"fields": {
				"input_device": "string"
			}
		},
		{
			"class_name": "npc",
			"base_class_name": "actor",
			"class_description": "a gaming NPC",
			"fields": {

			}
		},
		{
			"class_name": "feature",
			"base_class_name": "piece",
			"class_description": "a static feature on a map",
			"fields": {
				"scheduler": "scheduler"
			}
		},
		{
			"class_name": "use_plate",
			"base_class_name": "feature",
			"class_description": "a use plate",
			"fields": {
				"target_piece": "->piece"
			}
		},
		{
			"class_name": "spawn",
			"base_class_name": "feature",
			"class_description": "a gaming spawn point",
			"fields": {

			}
		},
		{
			"class_name": "player_spawn",
			"base_class_name": "feature",
			"class_description": "player_spawn",
			"fields": {

			}
		},
		{
			"class_name": "npc_spawn",
			"base_class_name": "feature",
			"class_description": "npc spawn",
			"fields": {
				"spawn_types": [ "string" ],
				"scheduler": "function_scheduler"
			}
		},
		{
			"class_name": "loot_box",
			"base_class_name": "feature",
			"class_description": "a gaming loot box",
			"fields": {

			}
		},
		{
			"class_name": "firearm",
			"base_class_name": "tool",
			"class_description": "weapon for the shot",
			"fields": {
				"fire_point": "vector",
				"magazine_type": "string",
				"inventory": {
					"field_type": "chest",
					"item_class": "magazine"
				}
			}
		},
		{
			"class_name": "magazine",
			"base_class_name": "carryable",
			"class_description": "a magazine for the firearm",
			"parents": [ "firearm" ],
			"fields": {
				"magazine_type": "string",
				"capacity": "double",
				"ammunition_type": "string",
				"inventory": {
					"field_type": "chest",
					"item_class": "ammunition"
				}
			},
			"indexes": {
				"magazine_type_index": {
					"index_keys": [ "magazine_type" ]
				}
			}
		},
		{
			"class_name": "ammunition",
			"base_class_name": "carryable",
			"class_description": "ammo for the firearm",
			"fields": {
				"ammunition_type": "string",
				"shot_type": "string",
				"shot_muzzle_velocity": "double",
				"shot_mass": "double",
				"inventory": {
					"field_type": "chest",
					"item_class": "shot"
				}
			}
		},
		{
			"class_name": "shot",
			"base_class_name": "piece",
			"class_description": "an effect of a weapon",
			"fields": {
				"shot_type": "string",
				"effect_type": "string",
				"inventory": {
					"field_type": "chest",
					"item_class": "effect"
				}
			}
		},
		{
			"class_name": "set",
			"base_class_name": "game_base",
			"class_description": "a gaming map",
			"parents": [ "theater" ],
			"fields": {
				"name": "string",
				"description": "string",
				"contents": "[ piece_list ]",
				"tile_strings": [ "string" ],
				"tile_size": "vector",
				"tile_codes": [ "piece_code" ]
			}
		},
		{
			"class_name": "adventure",
			"base_class_name": "game_base",
			"class_description": "playing a game is having an adventure",
			"parents": [ "game" ],
			"full_text": [ "name", "description" ],
			"fields": {
				"name": {
					"field_type": "string",
					"label": "Name",
					"max_length": 100
				},
				"team_name": {
					"field_type": "string",
					"label": "Team Name",
					"max_length": 100
				},
				"description": {
					"field_type": "string",
					"label": "Description"
				},
				"stage": "set",
				"state": {
					"field_type": "string",
					"label": "State",
					"max_length": 20,
					"enumeration": [ "lobby", "active", "paused", "complete", "exit" ]
				}
			}
		},
		{
			"class_name": "activity",
			"base_class_name": "game_base",
			"class_description": "An activity",
			"full_text": [ "name", "description", "image" ],
			"fields": {
				"name": {
					"field_type": "string",
					"label": "Name",
					"max_length": 100
				},
				"description": {
					"field_type": "string",
					"label": "Description"
				},
				"image": "bitmap"
			}
		},
		{
			"class_name": "game",
			"base_class_name": "activity",
			"class_description": "A world with rules one may adventure in",
			"fields": {
				"name": {
					"field_type": "string",
					"label": "Name",
					"max_length": 100
				},
				"description": {
					"field_type": "string",
					"label": "Description"
				},
				"stage": "set",
				"adventures": [ "adventure" ]
			},
			"indexes": {
				"game_name_index": {
					"index_keys": [ "name" ]
				}
			}
		},
		{
			"class_name": "essay",
			"base_class_name": "activity",
			"class_description": "An essay in the system",
			"fields": {
				"text": "string"
			}
		}
	],
